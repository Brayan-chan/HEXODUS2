{
  "name": "hexodus-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{css,js,json}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{js,json}\"",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "capture:reference": "node scripts/capture-reference.mjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "chokidar": "3.6.0",
    "gsap": "3.15.0",
    "nunjucks": "3.2.4",
    "vite": "8.3.5"
  }
}
